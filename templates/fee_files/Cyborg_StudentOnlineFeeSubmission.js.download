        var feetype = $("#ddlFeeType").val();

        $.jgrid.gridUnload('tblHead');
        $.jgrid.gridUnload('tblHeadHostel');
        $.jgrid.gridUnload('tblScholarship');

        if (feetype == '0') {
            $("#dvfeedetail").hide();
            $("#dvLoading").hide();
            $("#dvHostelamount").hide();
            $("#dvtotalamount").show();
            $("#txtAmountHostel").val('0.00');
            $("#txtAmount").val('0.00');
            $("#dvHostel").hide();
            return;
        }
        if (feetype == '1') {
            $("#ddlDuration").val('1');
            $("#dvHostelamount").hide();
            $("#dvtotalamount").show();
            $("#txtAmountHostel").val('0.00');
            $("#txtAmount").val('0.00');
            $("#dvHostel").hide();
            FillClientBankDetails();
            GetFeeHeadList();

            $("#ddlGateway").val('0');
            $("#bank").val($("#ddlGateway").val());

        }
        if (feetype == '2') {

            var HostelID = $("#ddlHostel").val();    //// new code

            if (HostelID == '5' || HostelID == '8' || HostelID == '10' || HostelID == '21') {

                $("#ddlGateway").val('Easebuzz').trigger('change');
                $("#ddlGateway").prop("disabled", true);
                $("#ddlHostel").prop("disabled", false);
                $("#dvHostel").show();
            }
            else {

                $("#ddlGateway").val('0');
                $("#bank").val($("#ddlGateway").val());
            }

            $("#ddlDuration").val('0');
            $("#ddlDuration").prop('disabled', true);
            $("#dvHostelamount").show();
            $("#dvtotalamount").hide();
            $("#txtAmountHostel").val('0.00');
            $("#txtAmount").val('0.00');
            FillClientBankDetails();
            GetFeeHeadList();
            if ($("#Msg").val() == 'UU') {
                $("#dvHostel").show();
            }
        }
        $("#lblbalforduration").text('('+$("#ddlDuration option:selected").text()+')');
        
    });
    
    $("#ddlDuration").change(function () {
        $("#lblbalforduration").text('');
        $("#ddlDuration").prop('disabled', false);
        $("#dvLoading").show();
        $("#lblMainFeeDue").text('0.00');
        $("#lblSubmitAmount").text('0.00');
        $("#lblBalance").text('0.00');
        $("#txtAmount").val('0.00');
        $("#lblScholarship").text('0.00');
        $("#TotalAmount").val(0.00);
        $("#ExcessAmount").val(0.00);
        $("#lblExcessAmount").text("0.00");
        $("#lblMainFeeFine").text("0.00");

       
        var feetype = $("#ddlFeeType").val();

        $.jgrid.gridUnload('tblHead');
        $.jgrid.gridUnload('tblHeadHostel');
        $.jgrid.gridUnload('tblScholarship');

        if (feetype == '0') {
