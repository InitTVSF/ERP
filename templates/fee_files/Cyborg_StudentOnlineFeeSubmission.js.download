    $("#lnkCliamExcsAmnt").click(function () {
        var GTID = 5;
        var date = $("#txtDate").text();
        var loc = '';
        var sub = 'Refund Fee';
        var complain = 'Refund of Excess Fee';
        var Rows = '[]';

        bootbox.confirm("<b>Are you sure you want to apply to claim excess fee amount ?</b>", function (result) {
            if (result) {
                var dialog = bootbox.dialog({
                    message: '<p class="text-center mb-0"><img src="../Images/LoginImg/loading.svg" style="width:50px; height:50px;"/>  Please wait ...</p>',
                    closeButton: false
                });
                $.ajax({
                    type: "POST",
                    // url: 'Url.Action("SendComplain", "Grievances")',
                    url: '../Grievances/SendComplain',
                    data: { date: date, loc: loc, GTID: GTID, sub: sub, complain: complain, Rows: Rows },
                    datatype: "json",
                    success: function (response) {
                        dialog.modal('hide');
                        if (response == 1) {
                            bootbox.alert('<img src="../img/submit.png" style="width:30px; height:30px;"/><b> &nbsp;&nbsp;Your Grievance regarding refund of excess fee has been sent successfully, you can see updated status of your grievance in Grievance Section.</b>');
                        }
                        else if (response == 0) {
                            bootbox.alert('<img src="../img/failure.png" style="width:30px; height:30px;"/><b> &nbsp;&nbsp; Error in process, Please Contact to Erp Cell.</b>');
                        }
                    }
                });
            }
        });
    });

