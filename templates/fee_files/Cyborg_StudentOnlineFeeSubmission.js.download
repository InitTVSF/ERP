$(document).ready(function () {

    $("#lnkScholarshipDetailmodel").hide();
    $("#dvNoCharges").hide();

    if ($("#Msg").val() != 'BFIT') {
        $("#dvHideGrid").show();
        $("#dvHostelGrid").show();
    }
    else
    {
        $("#dvHostelGrid").hide();
        $("#dvHideGrid").hide();
    }

    if ($("#Msg").val() == 'SCE') {
        $("#dvPaymentOption").show();
    } else {
        $("#dvPaymentOption").show();
    }

    if ($("#Msg").val() == 'UU') {
        $("#dvuuNote").show();
    } else {
        $("#dvuuNote").hide();
    }

    if ($("#Msg").val() == 'CGC') {
        $("#dvButtonClick").show();
        $("#dvButtonSubmit").hide();
    }
    else {
        $("#dvButtonClick").hide();
        $("#dvButtonSubmit").show();
        $("#dvNoCharges").show();        
    }

    $(".captchatext").text($("#captchaenter").val());
    //  FillCaptcha();

    $("#btnRefreshCaptcha").click(function () {
        FillCaptcha();
    });

    $("#lnkScholarshipDetailmodel").click(function () {
        FillScholarshipDetails();
    });

    $(".btnSubmit").click(function () {

        if ($("#ddlPaymentType").val() == '2' && $("#Msg").val() == 'UU') {
            return false;
        }

        if ($("#Msg").val() == 'QGC') {
            if ($("#TotalAmount").val() == '' || parseFloat($("#TotalAmount").val()) < 10) {
                $('#txtAmount').attr('data-original-title', 'Amount should be minimum 10 INR')
                  .tooltip('fixTitle')
                  .tooltip('show');
                $("#txtAmount").focus();
                return false;
            }
        }
        else {
            if ($("#Msg").val() == 'GEU') {
                if ($("#ddlPaymentType").val() == undefined || $("#ddlPaymentType").val() == null || $("#ddlPaymentType").val() == '0') {
                    $('#txtAmount').attr('data-original-title', 'Please select a payment mode')
                     .tooltip('fixTitle')
                     .tooltip('show');
                    $("#txtAmount").focus();
                    return false;
                }
                if ($("#ddlPaymentType").val() == '2')
                {
                    return false;
                }
                if ($("#ddlGateway").val() == undefined || $("#ddlGateway").val() == null || $("#ddlGateway").val() == '0' || $("#ddlGateway").val() == '') {
                    $('#ddlGateway').attr('data-original-title', 'Please select a payment gatway')
                    .tooltip('fixTitle')
                    .tooltip('show');
                    $("#ddlGateway").focus();
                    return false;
                }
            }

            if ($("#TotalAmount").val() == '' || parseFloat($("#TotalAmount").val()) == 0) {
                $('#txtAmount').attr('data-original-title', 'Amount should be minimum 1 INR')
               .tooltip('fixTitle')
               .tooltip('show');
                $("#txtAmount").focus();
                return false;
            }

            
            if ($("#TotalAmount").val() != '' || parseFloat($("#TotalAmount").val()) != 0) {
                if ($("#ddlFeeType").val() == '1') {
                    //if (parseFloat($("#TotalAmount").val()) > parseFloat($("#lblBalance").text())) {
                    //    $('#txtAmount').attr('data-original-title', 'Amount should not be exceed than balance amount.')
                    //   .tooltip('fixTitle')
                    //   .tooltip('show');
                    //    $("#txtAmount").focus();
                    //    return false;
                    //}
                }
            }

            if ($("#Msg").val() == 'UU') {
                if ($("#ddlFeeType").val() == '2') {
                    if ($("#ddlHostel").val() == null || $("#ddlHostel").val() == '' || $("#ddlHostel").val() == '0')
                    {
                        $('#ddlHostel').attr('data-original-title', 'Please select a hostel.')
                          .tooltip('fixTitle')
                          .tooltip('show');
                        $("#ddlHostel").focus();
                        return false;
                    }
                    if ($("#ddlRoomType").val() == null || $("#ddlRoomType").val() == '' || $("#ddlRoomType").val() == '0') {
                        $('#ddlRoomType').attr('data-original-title', 'Please select a hostel room seater.')
                          .tooltip('fixTitle')
                          .tooltip('show');
                        $("#ddlRoomType").focus();
                        return false;
                    }                    
                }                
            }            
        }

        if (String($("#txtcaptcha").val()).trim() == "") {
            $('#txtcaptcha').attr('data-original-title', 'Please enter captcha')
                 .tooltip('fixTitle')
                 .tooltip('show');
            $("#txtcaptcha").focus();
            //bootbox.alert('Please enter captcha.');
            return false;
        }

    });

    let qfixPay = new QfixPay();

    $("#btnSubmitClick").click(function (e) {

        //e.preventDefault();

        if ($("#lblMobile").text().trim() == "") {
            bootbox.alert("Student Mobile No. Not Registered In ERP");
            return false;
        }
        if ($("#lblMobile").text().trim() == "") {
            bootbox.alert("Student Mobile No. Not Registered In ERP");
            return false;
        }
        if ($("#lblCountry").text().trim() == "") {
            bootbox.alert("Student Country Not Registered In ERP");
            return false;
        }

        if ($("#TotalAmount").val() == '' || parseFloat($("#TotalAmount").val()) == 0) {
            $('#txtAmount').attr('data-original-title', 'Amount should be minimum 1 INR')
           .tooltip('fixTitle')
           .tooltip('show');
            $("#txtAmount").focus();
            return false;
        }
        if ($("#TotalAmount").val() != '' || parseFloat($("#TotalAmount").val()) != 0) {
            if ($("#ddlFeeType").val() == '1') {
                if (parseFloat($("#TotalAmount").val()) > parseFloat($("#lblBalance").text())) {
                    $('#txtAmount').attr('data-original-title', 'Amount should not be exceed than balance amount.')
                   .tooltip('fixTitle')
                   .tooltip('show');
                    $("#txtAmount").focus();
                    return false;
                }
            }
        }
        if (String($("#txtcaptcha").val()).trim() == "") {
            $('#txtcaptcha').attr('data-original-title', 'Please Enter captcha')
                 .tooltip('fixTitle')
                 .tooltip('show');
            $("#txtcaptcha").focus();
            return false;
        }

        var api_key = $("#hdnAPIKey").val(); //// "TERP00027";
        var scheme_code = $("#hdnSchemeCode").val(); //// "TERP00027_S1";
        var amount = String($("#TotalAmount").val().trim());
        
        let request = {
            initiated: function (response) {

                InsertPaymentInitiateRequest(response);
                ///alert(response);
                //window.location.href = "https://www.eduqfix.com/erp/integration/v2/verify?api_key=PERP00046&amp;scheme_code=PERP00047_S1&amp;qfix_reference_number=TERP000051576931585";
                //window.location.href = "https://www.eduqfix.com/erp/integration/v2/verify?api_key=TERP00005&amp;scheme_code=TERP00005_S1&amp;qfix_reference_number=TERP000051576931585";
                // This function is called when the transaction is initiated
            },
            success: function (response) {
                
                InsertPaymentResponseCGC(response);
                //alert(response);
                //alert("success");
                /* This function is called when the transaction is completed
                *  and successful
                */
            },
            error: function (response) {
                
                InsertPaymentResponseCGC(response);
                // Incase of any error, this callback function will be executed
                //TERP00027  TERP00027_S1
            },
            close: function (response) {

            },
            payload: {
                "api_key": api_key,
                "scheme_code": scheme_code,
                "payment_details": {
                    "amount": amount,
                    "currency": "INR"
                },
                "customer_details": {
                    "cn": $("#lblName").text().trim(),
                    "ce": $("#lblEmailID").text().trim(),
                    "cno": $("#lblMobile").text().trim()
                },
                "customer_address": {
                    "country": $("#lblCountry").text().trim(),
                    "address": $("#lblCity").text().trim()
                },
                "udf_1": "udf1",
                "udf_2": "udf2",
                "udf_3": "udf3",
                "udf_4": "udf4",
                "udf_5": "udf5"
            }
        }

        ValidateKeyScheme(request);

        if (window.result == "1") {
            qfixPay.init(request);
        }

    });

    $("#dvLoading").hide();
    $("#dvfeedetail").hide();
    $("#txtDate").text($("#ServerDate").val());

    GetStudentInfo();

    $("#ddlPaymentType").change(function () {

        $("#dvUUAccDetail").hide();
        $("#dvCaptcha").hide();
        $("#dvGenerateChallan").hide();

        $("#ModeOfPay").val($("#ddlPaymentType").val());

        if ($("#Msg").val() == 'GEU') {

            $("#ddlGateway").val('0');
            $("#bank").val($("#ddlGateway").val());
            $("#dvButtonClick").hide();

            if ($("#CollegeID").val() == '1' || $("#CollegeID").val() == '5') {

                if ($("#ddlPaymentType").val() == 1) {
                    $("#dvCaptcha").show();
                    $("#dvButtonSubmit").show();
                    ///$("#dvGEUAccDetail").hide();
                    ///$("#dvGEHUAccDetail").hide();
                }
                else {
                    $("#dvButtonSubmit").hide();
                    //$("#dvGEUAccDetail").fadeIn(100);
                    //$("#dvGEHUAccDetail").hide();
                    //$('html, body').animate({
                    //    scrollTop: ($('#dvGEUAccDetail').offset().top)
                    //}, 500);
                }
            }
            else {
                if ($("#ddlPaymentType").val() == 1) {
                    $("#dvCaptcha").show();
                    $("#dvButtonSubmit").show();
                    //$("#dvGEUAccDetail").hide();
                    //$("#dvGEHUAccDetail").hide();
                }
                else {
                    $("#dvButtonSubmit").hide();
                    //$("#dvGEUAccDetail").hide();
                    //$("#dvGEHUAccDetail").fadeIn(100);
                    //$('html, body').animate({
                    //    scrollTop: ($('#dvGEHUAccDetail').offset().top)
                    //}, 500);
                }
            }
        }
        else if ($("#Msg").val() == 'UU') {

            $("#dvButtonClick").hide();
            $("#dvButtonSubmit").hide();
            $("#dvNoCharges").hide();
            
            if ($("#ddlPaymentType").val() == "1") {
                $("#dvCaptcha").show();
                $("#dvButtonClick").hide();
                $("#dvButtonSubmit").show();
            }
            else if ($("#ddlPaymentType").val() == "2") {
                $("#dvGenerateChallan").show();
                $("#dvButtonClick").hide();
                $("#dvButtonSubmit").hide();
            }
            else if ($("#ddlPaymentType").val() == "3") {
                FillClientBankDetails();
                $("#dvGenerateChallan").hide();
                $("#dvButtonClick").hide();
                $("#dvButtonSubmit").hide();
            }
            else {
                $("#dvGenerateChallan").hide();
                $("#dvButtonClick").hide();
                $("#dvButtonSubmit").hide();
            }
        }
        else if ($("#Msg").val() == 'CGC') {
            $("#dvCaptcha").show();
            $("#dvButtonClick").show();
            $("#dvButtonSubmit").hide();
        }
        else {
            $("#dvCaptcha").show();
        }
    });

    if ($("#Msg").val() == 'UU' || $("#Msg").val() == 'QGC' || $("#Msg").val() == 'SCE' || $("#Msg").val() == 'CGC' || $("#Msg").val() == 'COER') {
        $("#lnkScholarshipDetail").hide();
        $("#dvexcesamnt").hide();
        $("#dvcontactno").hide();
        $("#dvnote").hide();
        $("#lnkCliamExcsAmnt").hide();
        $("#lnkScholarshipDetailmodel").hide();
        $('#lnkFeeInstallmentDetail').hide();
        
        if ($("#Msg").val() == 'UU') {
            $("#dvgateway").show();
            $("#ddlPaymentType").prop("disabled", false);
        }
        else {
            $("#dvgateway").hide();
            $("#ddlPaymentType").prop("disabled", true);
        }

        $("#ddlPaymentType").val('1');
        $("#ModeOfPay").val($("#ddlPaymentType").val());
    }
    else if ($("#Msg").val() == 'GEU') {
        $("#lnkScholarshipDetail").show();
        $("#lnkFeeInstallmentDetail").show();
        $("#ddlPaymentType").prop("disabled", false);
        $("#dvRefundAdjust").show();
        $("#dvcontactno").show();
        $("#dvuuNote").hide();
        $("#dvnote").show();
        $("#dvgateway").show();

        //GEU Fee Cell : 7088413131 | GEHU Fee Cell : 7088413132</
        if ($("#CollegeID").val() == '1' || $("#CollegeID").val() == '5') {

            $("#lblGEPhoneNo").text('7088413131');
            $("#ddlPaymentType").val('1');
            $("#ddlGateway").val('0');
            $("#ModeOfPay").val($("#ddlPaymentType").val());
            $("#dvflashnoteGEHU").hide();
        }
        else {
            setInterval(function () { blink() }, 1000);
            function blink() {
                $("#dvflashnoteGEHU").fadeTo(100, 0.1).fadeTo(200, 1.0);
            }
            $("#lblGEPhoneNo").text('7088413132');            
            $("#ddlPaymentType").val('1');
            $("#ddlGateway").val('0');
            $("#ModeOfPay").val($("#ddlPaymentType").val());
        }
    }

