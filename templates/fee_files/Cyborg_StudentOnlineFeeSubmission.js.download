function isNumberKey(evt, obj) {

    var charCode = (evt.which) ? evt.which : event.keyCode
    var value = obj.value;
    var dotcontains = value.indexOf(".") != -1;
    if (dotcontains)
        if (charCode == 46) return false;
    if (charCode == 46) return true;
    if (charCode > 31 && (charCode < 48 || charCode > 57))
        return false;
    return true;
}

function GetStudentAppliedScholarship() {
    $.ajax({
        type: "POST",
        //  url: '(Url.Action("GetStudentAppliedScholarship", "Web_StudentFinance"))',
        url: '../Student/GetStudentAppliedScholarship',
        data: { YearSem: $("#hdn_scholarshipSem").val() },
        datatype: "json",
        success: function (response) {
            $.jgrid.gridUnload('#tblScholarship');
            if (response.data == '1' || response.data == '2') {
                bootbox.alert("No record found");
                return;
            }

            $("#tblScholarship").jqGrid({
                datatype: "jsonstring",
                mtype: 'GET',

                autosize: true,
                shrinkToFit: false,
                height: "auto",
                width: null,

                //caption: "Subject Details",
                colNames: ['Year/Sem','Amount', 'Type', 'Scholarship', 'Remark'],
                colModel: [
                          {
                              name: 'YearSem', index: 'YearSem', align: 'left', search: false, width: 70, align: 'center'
                          },
                          {
                              name: 'Amount', index: 'Amount', align: 'left', search: false, width: 60, align: 'center'
                          },
                          {
                              name: 'Type', index: 'Type', align: 'left', search: false, width: 100,
                              cellattr: function (rowId, tv, rawObject, cm, rdata) { return 'style="white-space: normal; font-size:10px;"' }
                          },
                          {
                              name: 'Scholarship', index: 'Scholarship', align: 'left', search: false, width: 250,
                              cellattr: function (rowId, tv, rawObject, cm, rdata) { return 'style="white-space: normal; font-size:10px;"' }
                          },
                          {
                              name: 'Remark', index: 'Remark', align: 'left', search: false, width: 250,
                              cellattr: function (rowId, tv, rawObject, cm, rdata) { return 'style="white-space: normal; font-size:10px;"' }
                          }
                ],
                datastr: response.data,
                rownumbers: true,
                rowNum: 1000,
                viewrecords: true,
                //loadonce: true,
                paging: false,
                align: "center",
                //pager: "#pagerScholarship",
                multiselect: false,
            });
            $('#modelScholarshipView').modal('show');
        }
    });
}
