        closeButton: false
    });
    $.ajax({
        type: "POST",
        // url: '(Url.Action("GetAcademiceFeeFine", "Web_StudentFinance"))',
        url: '../Student/GetAcademiceFeeFine',
        data: { },
        datatype: "json",
        success: function (response) {
            //  
            dialog.modal('hide');
            $.jgrid.gridUnload('#tblAcademicFine');
            if (response.data == '1' || response.data == '2') {
                //bootbox.alert("No record found");
                return;
            }

            $("#tblAcademicFine").jqGrid({
                datatype: "jsonstring",
                mtype: 'GET',

                autosize: true,
                shrinkToFit: false,
                height: "auto",
                width: null,

                caption: "Academic Fine Details",
                colNames: ['Year/Sem', 'Amount'],
                colModel: [
                          {
                              name: 'YearSem', index: 'YearSem', align: 'left', search: false, width: 70, align: 'center'
                          },
                          {
                              name: 'Amount', index: 'Amount', align: 'left', search: false, width: 80, align: 'center',
                              formatter: 'number', formatoptions: { decimalPlaces: 2 } 
                          }                             
                ],
                datastr: response.data,
                // rownumbers: true,
                rowNum: 1000,
                viewrecords: true,
                //loadonce: true,
                paging: false,
                align: "center",
                //pager: "#pagerAcademicFine",
                multiselect: false,
            });
            // $('#modelAcademicFineView').modal('show');               
        }
    });
}

function getDueDate() {

    $.ajax({
        type: "POST",
        url: '../Student/getDueDate',
        data: {

        },
        datatype: "json",
        success: function (response) {

            if (response.DueDate != "") {
                $("#rowFeeFrequency").css('display', 'block');
                $("#rowDueDate").css('display', 'block');
                $("#lblFeeFrequency").html(response.periodType);
                $("#lblDueDate").html(response.DueDate);
            }
            else if (response.periodType != "") {   
                $("#rowDueDate").css('display', 'none');
                $("#lblDueDate").html("");
                $("#rowFeeFrequency").css('display', 'block');
                $("#lblFeeFrequency").html(response.periodType);
            }
            else {
                $("#rowFeeFrequency").css('display', 'none');
                $("#rowDueDate").css('display', 'none');
                $("#lblFeeFrequency").html("");
                $("#lblDueDate").html("");
            }
        }
    });

}

function ValidateKeyScheme(request) {

    if ($("#TotalAmount").val() == '' || parseFloat($("#TotalAmount").val()) == 0) {
        $('#txtAmount').attr('data-original-title', 'Amount should be minimum 1 INR')
       .tooltip('fixTitle')
       .tooltip('show');
        $("#txtAmount").focus();
        return false;
    }
    if ($("#TotalAmount").val() != '' || parseFloat($("#TotalAmount").val()) != 0) {
        if ($("#ddlFeeType").val() == '1') {
            if (parseFloat($("#TotalAmount").val()) > parseFloat($("#lblBalance").text())) {
                $('#txtAmount').attr('data-original-title', 'Amount should not be exceed than balance amount.')
               .tooltip('fixTitle')
               .tooltip('show');
                $("#txtAmount").focus();
                return false;
            }
        }
    }
    if (String($("#txtcaptcha").val()).trim() == "") {
        $('#txtcaptcha').attr('data-original-title', 'Please Enter captcha')
             .tooltip('fixTitle')
             .tooltip('show');
        $("#txtcaptcha").focus();
        return false;
    }

    var captcha = String($("#txtcaptcha").val()).trim();
    var FeeType = $("#ddlFeeType").val();

    var dialog = bootbox.dialog({
        message: '<p class="text-center mb-0"><img src="../Images/LoginImg/loading.svg" style="width:50px; height:50px;"/>  Please wait ...</p>',
        closeButton: false
    });

    $.ajax({
        url: '../Student/CGCQFixInitialization',
        datatype: "json",
        type: 'POST',
        async: false,
        data: {
            request: JSON.stringify(request), captcha: captcha, FeeType: FeeType
        },
        success: function (result) {

            dialog.modal('hide');
            window.result = result;
        }
    });

}

function InsertPaymentInitiateRequest(initialrequest) {

    if ($("#TotalAmount").val() == '' || parseFloat($("#TotalAmount").val()) == 0) {
        $('#txtAmount').attr('data-original-title', 'Amount should be minimum 1 INR')
       .tooltip('fixTitle')
       .tooltip('show');
        $("#txtAmount").focus();
        return false;
    }
    if ($("#TotalAmount").val() != '' || parseFloat($("#TotalAmount").val()) != 0) {
        if ($("#ddlFeeType").val() == '1') {
            if (parseFloat($("#TotalAmount").val()) > parseFloat($("#lblBalance").text())) {
                $('#txtAmount').attr('data-original-title', 'Amount should not be exceed than balance amount.')
               .tooltip('fixTitle')
               .tooltip('show');
                $("#txtAmount").focus();
                return false;
            }
        }
    }

    if (String($("#txtcaptcha").val()).trim() == "") {
        $('#txtcaptcha').attr('data-original-title', 'Please Enter captcha')
             .tooltip('fixTitle')
             .tooltip('show');
        $("#txtcaptcha").focus();
        return false;
    }

    var captcha = String($("#txtcaptcha").val()).trim();
    var FeeType = String($("#ddlFeeType").val());

    var TotalAmount = String($("#TotalAmount").val()).trim();
    var MainFee = String($("#txtAmount").val()).trim() == "" ? "0" : String($("#txtAmount").val()).trim();
    var SocietyFee = String($("#txtAmountHostel").val()).trim() == "" ? "0" : String($("#txtAmountHostel").val()).trim();
    var Duration = String($("#ddlDuration").val() == null || $("#ddlDuration").val() == undefined || $("#ddlDuration").val() == "" ? "0" : $("#ddlDuration").val());
    var ExcessAmount = String($("#lblExcessAmount").text()) == "" ? "0" : String($("#lblExcessAmount").text());
    var ModeOfPay = String($("#ddlPaymentType").val() == null || $("#ddlPaymentType").val() == undefined || $("#ddlPaymentType").val() == "" ? "1" : $("#ddlPaymentType").val());

    var HostelID = String($("#ddlHostel").val() == null || $("#ddlHostel").val() == undefined || $("#ddlHostel").val() == "" ? "0" :  $("#ddlHostel").val());
    var RoomType = String($("#ddlRoomType").val() == null || $("#ddlRoomType").val() == undefined || $("#ddlRoomType").val() == "" ? "0" : $("#ddlRoomType").val());

    var bank = $("#ddlGateway").val();
    var MainFeeFine = String($("#lblMainFeeFine").text()) == "" ? "0" : String($("#lblMainFeeFine").text());
    
    $.ajax({
        url: '../Student/InsertPaymentInitiateRequestCGC',
        datatype: "json",
        type: 'POST',
        async: false,
        data: {
            initialrequest: JSON.stringify(initialrequest), 
            captcha: captcha, FeeType: FeeType, MainFee: MainFee, SocietyFee: SocietyFee, Duration: Duration,
            ExcessAmount: ExcessAmount, ModeOfPay: ModeOfPay, HostelID: HostelID, RoomType: RoomType,
            bank: bank, MainFeeFine: MainFeeFine, TotalAmount: TotalAmount
        },
        success: function (response) {

            if (response != "Fee Submission Successfully") {

            }
        }
    });

}

function InsertPaymentResponseCGC(request) {

    var FeeType = String($("#ddlFeeType").val());

    $.ajax({
        url: '../Student/InsertPaymentResponseCGC',
        datatype: "json",
        type: 'POST',
        async: false,
        data: {
            request: JSON.stringify(request), FeeType: FeeType
        },
        success: function (response) {

            location.reload();

        }
    });

}
//-----------------------------------Scholarship grid------------------------------
function FillScholarshipDetails() {

    $.ajaxSettings.traditional = true;

    $.ajax({
        url: '../Student/FillScholarshipDetails',
        datatype: "json",
        type: 'POST',
        data: {

        },
        success: function (response) {
            $.jgrid.gridUnload('tblStuScholarshipDetails');
            var dt = JSON.parse(response.state);

            $("#tblStuScholarshipDetails").jqGrid({
                datatype: "jsonstring",
                mtype: 'GET',
                width: "100%",
                height: "auto",
                autowidth: true,
                autosize: true,
                shrinkToFit: false,
                height: "400",
                colNames: [
                     'Document', 'IsDocument', 'ScholarshipReceiveID', 'Session', 'Yea/rSem', 'IsPercentageWise', 'Percentage',
	                ' Amount', 'Scholarship Discount', 'Scholarship', 'Remark'],

                colModel: [

                       { name: 'Document', index: 'Document', width: 200, align: 'left', hidden: true },
                       { name: 'IsDocument', index: 'IsDocument', width: 300, align: 'left', hidden: true },
                       { name: 'ScholarshipReceiveID', index: 'ScholarshipReceiveID', width: 200, align: 'left', hidden: true },
                       { name: 'Session', index: 'Session', width: 100, align: 'center' },
                       { name: 'YearSem', index: 'YearSem', width: 100, align: 'center' },
                       { name: 'IsPercentageWise', index: 'IsPercentageWise', width: 150, align: 'left', hidden: true },
                       { name: 'Percentage', index: 'Percentage', width: 150, align: 'left', hidden: true },
                       { name: 'Amount', index: 'Amount', width: 200, align: 'center' },
                       { name: 'Sch./Dis.', index: 'Sch./Dis.', width: 200, align: 'center' },
                       { name: 'Scholarship', index: 'Scholarship', width: 250, align: 'left' },
                       { name: 'Remark', index: 'Remark', width: 50, align: 'center', hidden: true }


                ],
                datastr: dt,
                rownumbers: true,
                rowNum: 2000,
                viewrecords: true,
                loadonce: true,
                caption: ' ',
                paging: true,
                align: "center",
                pager: "#pgrStuScholarship",
                editable: true,
            });
            $("#tblStuScholarshipDetails").jqGrid('filterToolbar', { stringResult: true, searchOnEnter: false, defaultSearch: "cn" });

            $('#tblStuScholarshipDetails').jqGrid('navGrid', '#pgrStuScholarship', {
                search: false,
                searchtext: "Search",  //  Make the Search icon have a "Search" label next to it
                edit: false,
                add: false,
                del: false,
                refresh: false
            },
            {
                closeOnEscape: true, closeAfterSearch: true, ignoreCase: true, multipleSearch: false, multipleGroup: false, showQuery: false,
                sopt: ['cn', 'eq', 'ne'],
                defaultSearch: 'cn'
            }).navButtonAdd('#pgrStuScholarship', {
                caption: "Export",
                buttonicon: "ui-icon-disk",
                onClickButton: function () {

                    //This part is fix for all
                    $("#ddlExportType").val(2);
                    $("#txtReportTitle").val("");
                    $("#ddlPageSize").val(1);
                    $("#ddlPageOrientation").val(1);
                    $("#ddlReportHeaderFontSize").val(7);
                    $("#ddlContentFontSize").val(5);
                    $("#txtReportDescription").val("");

                    //this part depend on form and changebale

                    $("#hdnJQGridName").val("#tblStuScholarshipDetails");
                    $("#txtReportTitle").val("Scholarship Details ");
                    $('#modelReportDetails').modal('show');
                },
                position: "last"
            });
            $('#modelLinkPopUp').modal('show');
        }
    });
}

function FillClientBankDetails() {

    $("#dvAccountHolderName").html("");
    $("#dvAccountNo").html("");
    $("#dvBankName").html("");
    $("#dvBankIFSCCode").html("");

    $("#dvAccountHolderNameHostel").html("");
    $("#dvAccountNoHostel").html("");
    $("#dvBankNameHostel").html("");
    $("#dvBankIFSCCodeHostel").html("");

    $("#dvUUAccDetail").hide();

    var FeeType = String($("#ddlFeeType").val());
    var PaymentType = String($("#ddlPaymentType").val());
    var Gateway = String($("#ddlGateway").val());

    $.ajax({
        url: '../Student/FillClientBankDetails',
        datatype: "json",
        type: 'POST',
        async: false,
        data: {
            FeeType: FeeType, PaymentType: PaymentType, Gateway: Gateway, IsNewStudent: 0
        },
        success: function (response) {

            var dt = JSON.parse(response.state);

            if (dt.length > 0) {

                $("#dvAccountHolderName").html(dt[0]["AccountHolderName"]);
                $("#dvAccountNo").html(dt[0]["BankAccountNo"]);
                $("#dvBankName").html(dt[0]["BankName"]);
                $("#dvBankIFSCCode").html(dt[0]["BankIFSCCode"]);

                $("#dvAccountHolderNameHostel").html(dt[0]["AccountHolderNameHostel"]);
                $("#dvAccountNoHostel").html(dt[0]["BankAccountNoHostel"]);
                $("#dvBankNameHostel").html(dt[0]["BankNameHostel"]);
                $("#dvBankIFSCCodeHostel").html(dt[0]["BankIFSCCodeHostel"]);


                $("#dvUUAccDetail").show();
            }
        }
    });
}