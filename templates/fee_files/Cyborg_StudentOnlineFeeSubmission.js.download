                OptionBank = OptionBank + "<option value=\"2\" selected=\"selected\">Axis Challan</option>";
            }
            else {          /////////////////////////  GEHU
                OptionBank = OptionBank + "<option value=\"2\" selected=\"selected\">HDFC Challan</option>";
            }
        }
        else if ($("#Msg").val() == "UU") {
            
            OptionBank = OptionBank + "<option value=\"1\">PNB Challan</option>";
            OptionBank = OptionBank + "<option value=\"2\">Dena Challan</option>";
            $("#lblFeeType").show();
            $("#dvFeeType").show();
            $("#optHostelFee").show();
            $("#ddlFeeType1").attr("disabled", false);
            $("#ddlBankChallan").attr("disabled", false);
            $("#ddlFeeType1").val(0);
        }
        else {
            $("#lblFeeType").show();
            $("#dvFeeType").show();
            $("#optHostelFee").show();
            $("#ddlFeeType1").attr("disabled", false);
            $("#ddlBankChallan").attr("disabled", false);
            $("#ddlFeeType1").val(0);
        }

        $("#ddlBankChallan").html(OptionBank);

        $("#btnGenerateChallan").click(function (e) {
            $.ajaxSettings.traditional = true;

            if ($("#Msg").val() == "UU") {

                if ($("#ddlFeeType").val().trim() == "" || $("#ddlFeeType").val() == "0") {
                    bootbox.alert("Please Select Fee Type. ");
                    return;
                }
                if ($("#TotalAmount").val().trim() == "" || parseFloat($("#TotalAmount").val()) == 0) {
                    $('#txtAmount').attr('data-original-title', 'Amount should be minimum 1 INR')
                   .tooltip('fixTitle')
                   .tooltip('show');
                    $("#txtAmount").focus();
                    return false;
                }

                if ($("#ddlGateway").val() == undefined || $("#ddlGateway").val() == null || $("#ddlGateway").val() == '0' || $("#ddlGateway").val() == '') {
                    $('#ddlGateway').attr('data-original-title', 'Please select a payment gatway')
                    .tooltip('fixTitle')
                    .tooltip('show');
                    $("#ddlGateway").focus();
                    return false;
                }

                var AmountToPay = String($("#TotalAmount").val().trim());
                var FeeType = $("#ddlFeeType").val();
                var Gateway = $("#ddlGateway").val();

                $.ajax({
                    url: '../Student/GetHdfcStudentChallanDetails',
                    datatype: "json",
                    type: 'POST',
                    data: {
                        FeeType: FeeType, AmountToPay: AmountToPay, Gateway: Gateway
                    },
                    success: function (response) {

                        var dt = JSON.parse(response.newdata);

                        if (dt.length == 0 || dt == undefined) {
                            bootbox.alert("No record found");
                            return;
                        }
                        else {
                            window.open('../SMSReport/Cyborg_SMSCommonViewer', '_blank');
                            return;
                        }
                    }
                });
            }
            else {
                $('#modelChallan').modal('show');
            }
           
        });

        $("#btnDownload").click(function (e) {

            e.preventDefault();

            if ($("#ddlFeeType1").val() == 0) {
                bootbox.alert("Please Select Fee Type. ");
                return;
            }
            if ($("#ddlBankChallan").val() == 0) {
                bootbox.alert("Please Select Bank Challan. ");
                return;
            }

            var dialog = bootbox.dialog({
                message: '<p class="text-center mb-0"><img src="../Images/LoginImg/loading.svg" style="width:50px; height:50px;"/>  Please wait ...</p>',
                closeButton: false
            });

            $.ajax({
                type: "POST",
                url: '../Student/GetStudentFeeChallanDetails_ostulgn',
                data: { FeeType: $("#ddlFeeType1").val(), BankChallan: $("#ddlBankChallan").val() },
                async: false,
                datatype: "json",
                success: function (response) {

                    dialog.modal('hide');

                    var dt = response.state;
                    var Message = response.msg;

                    if (Message == undefined) {
                        window.open('../SMSReport/Cyborg_SMSCommonViewer', '_blank');
                    }
                    else if (Message.length > 0) {
                        bootbox.alert(Message);
                        return;
                    }
                }
            });

        });

        $("#btnDownloadBankDetails").click(function (e) {
            PrintElem();
        });

    });

    $(document).ready(function () {

        $("#lnkScholarshipDetailmodel").click(function () {
            FillScholarshipDetails();
        });

        $("#lnkMainFeeFineDetail").click(function () {         
            $("#dvAcademicFine").toggle(300);            
        });

        if ($("#Msg").val() == 'GEU') {

            if ($("#CollegeID").val() == '2' || $("#CollegeID").val() == '3' || $("#CollegeID").val() == '4') {

                $("#lnkScholarshipDetailmodel").show();

            }

        }

    });

    function PrintElem() {

        const element = document.getElementById('dvUUBankDetails');

        if ($("#dvAccountHolderName").html().trim() == "") {
            bootbox.alert("No Bank Details Found.");
            return;
        }
        html2pdf(element, {
            filename: 'BankDetails.pdf',
            margin: [20, 20, 20, 20],
        });
    }


function GetAcademiceFeeFine() {
    var dialog = bootbox.dialog({
