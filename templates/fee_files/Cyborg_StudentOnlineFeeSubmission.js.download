function GetStudentInfo() {
    $.ajax({
        type: "Get",

        //   url: '(Url.Action("GetStudentInfo", "Web_StudentFinance"))',
        url: '../Student/GetStudentInfo',
        data: {},
        datatype: "json",
        success: function (response) {

            if (response.data == '2') {
                bootbox.alert('A problem occured in process, please contact to ERP cell.');
                return;
            }
            if (response.data == '1') {
                bootbox.alert('Your information is not updated on ERP, Please contact to ERP cell.');
                return;
            }

            var dt = JSON.parse(response.data);

            $("#lblName").text(dt[0].Name);
            $("#lblStudentID").text(dt[0].StudentID);
            $("#lblledger").text(dt[0].Ledger);
            $("#lblCourse").text(dt[0].Course);
            $("#lblStudentType").text(dt[0].StudentType);
            $("#lblYear").text(dt[0].Yr);
            $("#lblSem").text(dt[0].Sm);

            if ($("#Msg").val() == 'CGC') {

                $("#dvMobileNo").show();
                $("#dvEmailID").show();

                $("#dvCountry").show();
                $("#dvCity").show();

                $("#lblMobile").text(dt[0].MobileNo);

                //$("#lblEmailID").text("test@gmail.com");
                $("#lblEmailID").text(dt[0].EmailID);
                $("#lblCountry").text(dt[0].Country);
                $("#lblCity").text(dt[0].City);                
            }           

            if ($("#Msg").val() == 'GEU') {

                if (dt[0].StuSYID == '23') {
                    $("#dvflashnote").show();
                }
                else {
                    $("#dvflashnote").hide();
                }
            }

            //var duration = parseInt(dt[0].Duration);
            //var ddlObj = $("#ddlDuration");
            //var items = "<option selected=\"selected\" value='0'>--All--</option>";
            //for (var i = 1; i <= duration; i++) {
            //    items += "<option value='" + i + "'>" + i + "</option>";
            //}
            //ddlObj.html(items);
        }
    });
}

