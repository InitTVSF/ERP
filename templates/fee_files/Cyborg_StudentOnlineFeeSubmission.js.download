function GetStudentFeeData() {
    $.ajaxSettings.traditional = true;


    $.ajax({
        type: "POST",
        url: '../Student/GetStudentFeeData_ostulgn',
     
        datatype: "json",
        data: {
            
        },
        success: function (response) {

            $.jgrid.gridUnload('jqgrd');
            var dt = response;


            $("#jqgrd").jqGrid({
                datatype: "jsonstring",
                mtype: 'GET',
              
                autosize: true,
                shrinkToFit: false,
                height: "150",
                width: null,

                colNames: ['Period Type', 'Plan Type', 'YearSem', '1stDate ', '1st Installment', '1stScholarship', '1stReceiving', '1stBalance', '2ndDate',
                    '2nd Installment', '2ndScholarship', '2ndReceiving', '2ndBalance', '3rdDate', '3rd Installment', '3rdScholarship', '3rdReceiving', '3rdBalance',
                    '4thDate', '4th Installment', '4thScholarship', '4thReceiving', '4thBalance'],
                colModel: [

                            { name: 'PeriodType', index: 'PeriodType', width: 80, align: 'center', hidden: true },
                            { name: 'PlanType', index: 'PlanType', width: 90, align: 'center' },
                             { name: 'YearSem', index: 'YearSem', width: 70, align: 'center' },
                            { name: '1stDate', index: '1stDate', width: 80, align: 'center' },
                            { name: '1st Installment', index: '1st Installment', width: 90, align: 'left' },
                            { name: '1stScholarship', index: '1stScholarship', width: 90, align: 'left' },
                            { name: '1stReceiving', index: '1stReceiving', width: 70, align: 'left' },
                            { name: '1stBalance', index: '1stBalance', width: 70, align: 'center' },
