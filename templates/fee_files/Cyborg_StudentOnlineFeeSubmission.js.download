
function FillCaptcha() {
        $.ajax({
            url: '../Common/GenerateCaptchaCode',
            datatype: "json",
            type: 'POST',
            async: false,
            data: {},
            success: function (response) {
                $(".captchatext").text(response);
            }
        });
    }

function GetFeeHeadList() {
    $("#dvfeedetail").show();
    $.jgrid.gridUnload('tblHead');
    $.jgrid.gridUnload('tblHeadHostel');
    var FeeType = $("#ddlFeeType").val();
    var duration = $("#ddlDuration").val();
    if (FeeType == '0' || FeeType == '') {
        //$("#ddlFeeType").val('1');
        FeeType = 0;
        $("#dvHostelamount").hide();
        $("#dvtotalamount").show();
        $("#txtAmountHostel").val('0.00');
        $("#txtAmount").val('0.00');
    }

    if (duration == '0') {
        $("#ddlDuration").val('0');
        duration = '0';
    } else if (duration == '1') {
        $("#ddlDuration").val('1');
        duration = '1';
    } else if (duration == '2') {
        $("#ddlDuration").val('2');
        duration = '2';
    } else {
        $("#ddlDuration").val('0');
        duration = '0';
    }
    $("#lblbalforduration").text('(' + $("#ddlDuration option:selected").text() + ')');
    var dialog = bootbox.dialog({
        message: '<p class="text-center mb-0"><img src="../Images/LoginImg/loading.svg" style="width:50px; height:50px;"/>  Please wait ...</p>',
        closeButton: false
    });

    $.ajax({
        //url: 'Url.Action("FillHead", "Web_StudentFinance")',
        url : '../Student/FillHead',
        datatype: "json",
        type: 'POST',
        data: {
            FeeType: FeeType,
            duration: duration
        },
        success: function (response) {

            if (response.headdata == '0') {
                bootbox.alert('A problem occured in process, please contact to ERP cell');
                return;
            }
            var dt = response.headdata;
            var parsdt = JSON.parse(dt);

            var dthostel = response.headdatahostel;

            $.jgrid.gridUnload('tblHeadHostel');
            $.jgrid.gridUnload('tblHead');

            if (FeeType == '1') {
                $("#dvHostelamount").hide();
                fillHeadData(dt);
            } else if (FeeType == '2') {
                $("#dvtotalamount").hide();
                fillHeadDataHostel(dthostel);
            } else if (FeeType == '3') {
                fillHeadData(dt);
                fillHeadDataHostel(dthostel);
            } else {
                $.jgrid.gridUnload('tblHeadHostel');
                $.jgrid.gridUnload('tblHead');
            }

            var mainfeefine = 0;
            if (parsdt.length > 0 && parseFloat(parsdt[0]["FineAmount"]) > 0) {
                mainfeefine = parseFloat(parsdt[0]["FineAmount"]);
                $("#lblMainFeeFine").text(parseFloat(parsdt[0]["FineAmount"]).toFixed(2));
                $("#MainFeeFine").val(mainfeefine);
                $("#dvFineamount").show();
            } else {
                $("#lblMainFeeFine").text(0);
                $("#MainFeeFine").val(0);
                $("#dvFineamount").hide();
            }

            if (parsdt.length > 0) {
                if ($("#Msg").val() == 'GEU' && parseFloat(parsdt[0]["SecurityAdjusted"]) > 0) {
                    if ($("#hdnIsInternationalFee").val() == "1") {
                        $("#dvpaidAmount").html('<b style="color: #2F82B6" >Paid Amount (with Security Adjusted (' + parseFloat(parsdt[0]["SecurityAdjusted"]).toFixed(2) + ') (<i class="fa fa-usd"></i>)</b>');
                    }
                    else {
                        $("#dvpaidAmount").html('<b style="color: #2F82B6" >Paid Amount (with Security Adjusted (' + parseFloat(parsdt[0]["SecurityAdjusted"]).toFixed(2) + ') (<i class="fa fa-rupee"></i>)</b>');
                    }
                }
            }
            
            $("#hdn_scholarshipSem").val(response.scholarshipSem);

            $("#lblMainFeeDue").text(response.totaldue);
            $("#lblSubmitAmount").text(response.totalreceive);
            $("#lblScholarship").text(response.adjust);
            $("#lblBalance").text(parseFloat(response.totalbalance) + parseFloat(mainfeefine));
            $("#lblExcessAmount").text(response.excessfee);
            //$("#lblExcessAmount").val(response.excessfee);
            $("#ExcessAmount").val(response.excessfee);

            if (parseFloat(response.excessfee) > 0 && $("#Msg").val() == 'GEU') {
                $("#lnkCliamExcsAmnt").show();
            } else {
                $("#lnkCliamExcsAmnt").hide();
            }

            if ($("#Msg").val() == 'GEU' && parseInt($("#hostelprebal").val()) > 0) {
                bootbox.alert('<img src="../Images/Icons/pending.png"  style="width:30px; height:30px;"/><b style="color:red;"> &nbsp;&nbsp; Please clear your previous hostel dues (Rs. ' + $("#hostelprebal").val() + ') for further fee submission.</b>');
            }

            if (parseFloat($("#lblBalance").text()) - parseFloat($("#lblExcessAmount").text()) < 0) {
                $("#lblBalance").text('0.00');
            } else {
                $("#lblBalance").text((parseFloat($("#lblBalance").text()) - parseFloat($("#lblExcessAmount").text())).toFixed(2));
            }
                        
            $("#txtAmount").prop("readonly", false);
            $("#txtAmount").val('0.00');
            $("#TotalAmount").val('0.00');                
            
            $("#txtAmountHostel").val('0.00');
            $("#dvLoading").hide();
            
            //$("#tblHead").jqGrid('setFrozenColumns');

            dialog.modal('hide');
        },
        error: function (result) {
            alert("Error");
        }
    });
}

function fillHeadData(dt) {

    $("#tblHead").jqGrid({
        datatype: "jsonstring",
        mtype: 'GET',
        autosize: true,
        width: null,
        shrinkToFit: false,
        height: "auto",
        caption: $("#hdnIsInternationalFee").val() == "1" ? "Academic Fee Detail (Amount in <i class='fa fa-usd'></i>)" : "Academic Fee Detail (Amount in <i class='fa fa-rupee'></i>)",
        colNames: ['Sem/Year', 'Sem/Year', 'FeeHeadID', 'Fee Head', 'Current Dues Amount', 'Scholarship / Discount', 'Paid Amount', 'Balance Amount', 'To Pay'],
        colModel: [
             { name: 'YS', index: 'YS', width: 70, align: 'center', search: false },
             { name: 'YearSem', index: 'YearSem', width: 70, align: 'center', hidden: true },
             { name: 'FeeHeadID', index: 'FeeHeadID', align: 'right', hidden: true, search: false },
             { name: 'FeeHead', index: 'FeeHead', align: 'left', width: 130, search: false },
             { name: 'DueAmount', index: 'DueAmount', align: 'right', width: 80, search: false, formatter: 'number', formatoptions: { decimalPlaces: 2 } },
             { name: 'SCAmount', index: 'SCAmount', align: 'right', search: false, width: 80, formatter: 'number', formatoptions: { decimalPlaces: 2 } },
             { name: 'ReceivedAmount', index: 'ReceivedAmount', width: 80, align: 'right', search: false, formatter: 'number', formatoptions: { decimalPlaces: 2 } },
             { name: 'BalanceAmount', index: 'BalanceAmount', width: 80, align: 'right', search: false, formatter: 'number', formatoptions: { decimalPlaces: 2 } },
             {
                 name: 'DepositAmount', index: 'DepositAmount', hidden: true, width: 100, formatter: 'number', formatoptions: { decimalPlaces: 2 }, align: 'right', search: false, editable: true, edittype: 'text',
                 editoptions: {
                     style: "width: 100%; height:25px; text-align:center",
                     maxlengh: 4,
                     height: 10,
                     dataInit: function (element) {
                         $(element).keypress(function (e) {
                             if ((e.which != 8 && e.which != 0 && e.which != 46 && (e.which < 48 || e.which > 57))) {
                                 return false;
                             }
                         });
                         $(element).focusout(function (e) {
                             $(element).trigger($.Event("keydown", { keyCode: $.ui.keyCode.ENTER }))
                         });
                     },
                     dataEvents: [
                           {
                               type: 'keyup',
                               fn: function (e) {
                                   var myGrid = $('#tblHead'),
                                   selectedRowId = myGrid.jqGrid('getGridParam', 'selrow'),
                                   BalanceAmount = myGrid.jqGrid('getCell', selectedRowId, 'BalanceAmount');

                                   if ($(this).val() == '') {
                                       return false;
                                   }

                                   var amnt = parseFloat($(this).val());
                                   var rows = $("#tblHead").getDataIDs();

                                   if (parseFloat(BalanceAmount) == 0) {
                                       $(this).val(BalanceAmount);
                                       //return false;
                                   }

                                   if (parseFloat(BalanceAmount) < parseFloat(amnt)) {
                                       $(this).val(BalanceAmount);
                                       //return false;
                                   }

                                   amnt = parseFloat($(this).val());

                                   for (var i = 0; i <= rows.length; i++) {
                                       var rowData = $('#tblHead').jqGrid('getRowData', rows[i]);
                                       if (String(parseFloat(rowData.DepositAmount)) != 'NaN') {
                                           amnt = amnt + parseFloat(rowData.DepositAmount);
                                       }
                                   }
                                   $("#txtAmount").val(amnt);
                               }
                           },
                     ]
                 }
             },
        ],
        editable: true,
        'cellEdit': true,
        'cellsubmit': 'clientArray',
        editurl: "clientArray",
        datastr: dt,
        //rowheight: 300,
        rownumbers: true,
        rowNum: 1000,
        viewrecords: true,
        sortorder: "asc",
        loadonce: true,
        paging: true,
        align: "center",
        pager: "#pagerHead",
        multiselect: false,
        colMenu: false,

    });

}

